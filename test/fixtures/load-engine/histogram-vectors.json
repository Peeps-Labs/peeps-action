{
  "version": "hist/1",
  "buckets": [
    { "micros": 0, "bucket": 0, "lower": 0, "upper": 0 },
    { "micros": 127, "bucket": 127, "lower": 127, "upper": 127 },
    { "micros": 128, "bucket": 128, "lower": 128, "upper": 129 },
    { "micros": 129, "bucket": 128, "lower": 128, "upper": 129 },
    { "micros": 255, "bucket": 191, "lower": 254, "upper": 255 },
    { "micros": 256, "bucket": 192, "lower": 256, "upper": 259 },
    { "micros": 1000, "bucket": 317, "lower": 1000, "upper": 1007 },
    { "micros": 1048576, "bucket": 960, "lower": 1048576, "upper": 1064959 },
    { "micros": 3600000000, "bucket": 1707, "lower": 3590324224, "upper": 3623878655 }
  ],
  "percentiles": [
    {
      "name": "one value",
      "values": [5000],
      "expect": { "p50": 5055, "p95": 5055, "p99": 5055 }
    },
    {
      "name": "1..100 ms, one each",
      "values": "1..100 ms",
      "expect": { "p50": 50175, "p95": 95231, "p99": 99327 }
    },
    {
      "name": "an overflow at the tail",
      "values": [1000, 2000, 3600000001],
      "expect": { "p50": 2015, "p95": "overflow", "p99": "overflow" }
    },
    {
      "name": "nothing",
      "values": [],
      "expect": { "p50": null, "p95": null, "p99": null }
    }
  ]
}
